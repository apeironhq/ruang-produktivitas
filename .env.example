# Salin ke .env.local lalu isi. Di Vercel, isi lewat Project Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — jangan beri prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hanya untuk `npm run db:migrate` (lokal). Dashboard → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password-url-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres
